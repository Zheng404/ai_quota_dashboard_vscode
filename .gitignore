# ============================================
# AI Quota Dashboard — Git Ignore
# ============================================

# === 依赖与构建产物（无斜杠前缀 = 匹配任意深度）===
node_modules/
dist/
coverage/
out/
*.tsbuildinfo
*.map

# === VSCode Extension 专属 ===
.vscode-test/
.eslintcache

# === 打包产物 ===
*.vsix
*.zip
build/
# 注意：chrome/ 与 firefox/ 目录内的构建残留由各自嵌套的
# .gitignore 白名单拦截（只放行 manifest.json 与 icons/）

# === OS Generated ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# === IDE / Editor ===
.history/
.idea/
*.swp
*.swo
*~

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Environment / Secrets ===
.env
.env.local
.env.*.local

# === Temporary Files ===
*.tmp
*.temp
.cache/
tmp/

# === Runtime ===
# Cookie Bridge PID 端口文件：实际写入 os.tmpdir()/.ai-quota-bridge-port-{pid}
# 此处防御性忽略，防止调试时落在仓库内
.ai-quota-bridge-port-*

# === VSCode Workspace Settings ===
# (用户级个人设置，不应提交；launch.json/tasks.json/extensions.json 为团队共享)
.vscode/settings.json
