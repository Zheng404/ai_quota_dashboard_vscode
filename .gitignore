# ============================================
# AI Quota Dashboard — Git Ignore
# ============================================

# === 依赖与构建产物（无斜杠前缀 = 匹配任意深度）===
node_modules/
dist/
coverage/
out/
*.tsbuildinfo
*.map

# === VSCode Extension 专属 ===
.vscode-test/
.eslintcache

# === 打包产物 ===
*.vsix
*.zip
build/
# Firefox web-ext 打包输出目录
web-ext-artifacts/
# 注意：chrome/ 与 firefox/ 目录内的构建残留由各自嵌套的
# .gitignore 白名单拦截（只放行 manifest.json 与 icons/）

# === OS Generated ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# === IDE / Editor ===
.history/
.idea/
*.swp
*.swo
*~
# Serena 工具本地项目上下文（project.yml / memories / cache），不提交
.serena/

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Environment / Secrets ===
.env
.env.local
.env.*.local

# === Temporary Files ===
*.tmp
*.temp
.cache/
tmp/
# 合并/补丁工具残留
*.orig
*.rej

# === 密钥与证书（绝不可提交） ===
*.pem
*.key
# Chrome 扩展签名打包产物
*.crx

# === Runtime ===
# Cookie Bridge PID 端口文件：实际写入 os.tmpdir()/.ai-quota-bridge-port-{pid}
# 此处防御性忽略，防止调试时落在仓库内
.ai-quota-bridge-port-*

# === VSCode Workspace Settings ===
# (用户级个人设置，不应提交；launch.json/tasks.json/extensions.json 为团队共享)
.vscode/settings.json
