# ============================================
# AI Quota Dashboard — Git Ignore
# ============================================

# === 依赖与构建产物（无斜杠前缀 = 匹配任意深度）===
node_modules/
dist/
coverage/
out/
*.tsbuildinfo
*.map

# === VSCode Extension 专属 ===
.vscode-test/
.eslintcache

# === 通用打包产物 ===
*.vsix
*.zip
build/

# === OS Generated ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# === IDE / Editor ===
.history/
.idea/
*.swp
*.swo
*~
# Serena 工具本地项目上下文（project.yml / memories / cache），不提交
.serena/

# === Logs ===
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# === Environment / Secrets ===
.env
.env.local
.env.*.local

# === Temporary Files ===
*.tmp
*.temp
.cache/
tmp/
# 合并/补丁工具残留
*.orig
*.rej

# === 密钥与证书（绝不可提交）===
*.pem
*.key

# === VSCode Workspace Settings ===
# 用户级个人设置；launch.json/tasks.json/extensions.json 为团队共享
.vscode/settings.json

# Deepwork 本地进度文件
.slim/deepwork/
