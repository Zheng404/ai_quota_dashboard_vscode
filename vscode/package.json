{
  "name": "ai-quota-dashboard",
  "displayName": "AI Quota Dashboard",
  "description": "Monitor AI Coding Plan quota usage (GLM, Kimi, MiMo, etc.)",
  "version": "1.1.5",
  "publisher": "Zheng404",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zheng404/ai_quota_dashboard_vscode"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Visualization"
  ],
  "icon": "resources/icon.png",
  "keywords": [
    "ai",
    "quota",
    "usage",
    "glm",
    "kimi",
    "monitor",
    "coding-plan"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:aiQuotaDashboard.dashboardView",
    "onCommand:aiQuotaDashboard.refresh",
    "onCommand:aiQuotaDashboard.openDashboard",
    "onCommand:aiQuotaDashboard.openSettings",
    "onCommand:aiQuotaDashboard.clearHistory",
    "onCommand:aiQuotaDashboard.resetData"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiQuotaDashboard.refresh",
        "title": "刷新配额数据",
        "icon": "$(refresh)"
      },
      {
        "command": "aiQuotaDashboard.openDashboard",
        "title": "打开配额面板",
        "icon": "$(dashboard)"
      },
      {
        "command": "aiQuotaDashboard.resetData",
        "title": "重置所有数据"
      },
      {
        "command": "aiQuotaDashboard.openSettings",
        "title": "打开设置面板",
        "icon": "$(gear)"
      },
      {
        "command": "aiQuotaDashboard.clearHistory",
        "title": "清除历史数据"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiQuotaDashboard",
          "title": "AI 配额",
          "icon": "$(pulse)"
        }
      ]
    },
    "views": {
      "aiQuotaDashboard": [
        {
          "id": "aiQuotaDashboard.dashboardView",
          "name": "配额仪表盘",
          "type": "webview",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "AI Quota Dashboard",
      "properties": {
        "aiQuotaDashboard.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "description": "自动刷新间隔（秒）。设为 0 禁用自动刷新。",
          "order": 1
        },
        "aiQuotaDashboard.warnThreshold": {
          "type": "number",
          "default": 0.8,
          "minimum": 0,
          "maximum": 1,
          "description": "配额预警阈值（0-1）。当配额使用率超过此值时显示警告通知。",
          "order": 2
        },
        "aiQuotaDashboard.afkThreshold": {
          "type": "number",
          "default": 3600,
          "minimum": 0,
          "description": "AFK 检测阈值（秒）。用户无操作超过此时长后暂停自动刷新。设为 0 禁用 AFK 检测。",
          "order": 3
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile && npm run build",
    "compile": "tsc -p ./",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true});require('fs').rmSync('media',{recursive:true,force:true})\"",
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "pretest": "npm run compile",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:browser": "node esbuild.browser.mjs"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.56.0",
    "typescript": "^5.3.0",
    "vitest": "^2.1.9"
  }
}
